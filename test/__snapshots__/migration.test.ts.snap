"/**
 * Migrated from OpenCode V1 by opencode-plugin-migrate.
 * Source: test/fixtures/tools/index.ts
 * Review every "not converted automatically" block before shipping.
 */
import { Plugin } from "@opencode/plugin"
import { z as __z } from "zod"
import { referencedTool } from "./tools"

const ToolsPlugin = Plugin.define({
  id: "ToolsPlugin",
  async setup(__opencode) {
  const tool = Object.assign(
    (definition: {
      description: string
      args: any
      execute: (args: any, context: any) => any
    }) => definition,
    { schema: __z },
  )
  const __tool0 = tool({
      description: "Inline tool",
      args: {
        query: tool.schema.string().describe("Query text"),
      },
      async execute(args) {
        return \`inline:\${args.query}\`
      },
    })
    await __opencode.tool.transform((editor) => {
      editor.add({
        name: "inline",
        description: __tool0.description,
        input: __z.toJSONSchema(__z.object(__tool0.args)) as any,
        async execute(input: any, context: any) {
          const args: any = input
          const ctx: any = {
            ...context,
            abort: context.signal,
            directory: __opencode.location.directory,
            worktree: __opencode.location.directory,
            metadata: (_update: any) => {},
            ask: async (_input: any) => {},
          }
          const result: any = await __tool0.execute(args, ctx)
          if (typeof result === "string") return { content: result }
          if (result && typeof result === "object") {
            return { content: result.output, metadata: result.metadata }
          }
          return {}
        },
      })
    })
  const __tool1 = referencedTool
    await __opencode.tool.transform((editor) => {
      editor.add({
        name: "referenced",
        description: __tool1.description,
        input: __z.toJSONSchema(__z.object(__tool1.args)) as any,
        async execute(input: any, context: any) {
          const args: any = input
          const ctx: any = {
            ...context,
            abort: context.signal,
            directory: __opencode.location.directory,
            worktree: __opencode.location.directory,
            metadata: (_update: any) => {},
            ask: async (_input: any) => {},
          }
          const result: any = await __tool1.execute(args, ctx)
          if (typeof result === "string") return { content: result }
          if (result && typeof result === "object") {
            return { content: result.output, metadata: result.metadata }
          }
          return {}
        },
      })
    })
  },
})

export default ToolsPlugin
"
`;

