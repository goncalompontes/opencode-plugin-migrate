{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    "allowJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "benchmarks/*.ts"
  ],
  "exclude": [
    "test/fixtures/broken",
    "test/fixtures/mixed-v2"
  ]
}
